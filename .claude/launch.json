{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 5173
    },
    {
      "name": "peer",
      "runtimeExecutable": "./scripts/dev-peer.sh",
      "runtimeArgs": [],
      "port": 5174
    },
    {
      "name": "api-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/server && FRITH_DATA=.frith-data-preview FRITH_FILES=.data/uploads-preview PORT=3210 exec pnpm exec tsx watch src/index.ts"
      ],
      "port": 3210
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/web && FRITH_API_PORT=3210 exec pnpm exec vite --port 5273 --strictPort"
      ],
      "port": 5273
    },
    {
      "name": "api-seeded",
      "runtimeExecutable": "./scripts/seeded-api.sh",
      "runtimeArgs": [],
      "port": 3211
    },
    {
      "name": "web-seeded",
      "runtimeExecutable": "./scripts/seeded-web.sh",
      "runtimeArgs": [],
      "port": 5374
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "-d", "site"],
      "port": 4173
    }
  ]
}
