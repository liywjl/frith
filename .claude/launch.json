{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 5173
    },
    {
      "name": "peer",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-peer.mjs"],
      "port": 5174
    },
    {
      "name": "api-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/preview.mjs", "server"],
      "port": 3210
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/preview.mjs", "web"],
      "port": 5273
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "-d", "site"],
      "port": 4173
    }
  ]
}
