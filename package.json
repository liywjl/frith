{
  "name": "frith",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:seeded": "node scripts/dev.mjs --seeded",
    "dev:seeded:web": "node scripts/dev.mjs --seeded --web",
    "web:standalone": "node scripts/dev.mjs --seeded --web --web-port=9485",
    "seed": "pnpm --filter server seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "deadcode": "fallow dead-code && fallow dupes",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm deadcode",
    "dev:peer": "node scripts/dev-peer.mjs",
    "desktop": "pnpm --filter desktop build && pnpm --filter desktop start",
    "dev:web": "pnpm --parallel -r dev"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": ">=0.6.0",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "fallow": "^2.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
